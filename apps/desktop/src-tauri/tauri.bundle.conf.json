{
  "build": {
    "beforeBuildCommand": "node ../../tools/package/prepare.mjs && npm run build"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources-staged/engine/": "engine/",
      "resources-staged/node/": "node/",
      "resources-staged/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
